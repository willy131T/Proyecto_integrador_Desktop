# URL de la base de datos en la nube (PostgreSQL en Supabase, Neon o Render)
# Ejemplo Supabase: postgresql+psycopg://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require
# Si se deja en blanco o no existe, el sistema usa SQLite local (consultorio_dental.db) para desarrollo continuo.
DATABASE_URL=postgresql+psycopg://usuario:password@ep-host.region.aws.neon.tech/neondb?sslmode=require
APP_ENV=development
APP_NAME=OdontoCloud Desktop
